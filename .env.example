# Copy to .env for local development.
# On Vercel, add these under Project Settings -> Environment Variables.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: direct Postgres URI (auto-creates tables on first request)
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Required for automatic QR pass emails upon admin approval
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Afro Kravings <tickets@yourdomain.com>

# Optional: custom passcode for /aaddmmiin (defaults to 2340)
ADMIN_PASSCODE=2340
